  "definitions": {
    "StallInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Warung Baru"
        },
        "category": {
          "type": "string",
          "example": "Nasi"
        },
        "location": {
          "type": "string",
          "example": "Kantin FK"
        },
        "description": {
          "type": "string",
          "example": "Warung makan siang"
        }
      },
      "required": [
        "name"
      ]
    },
    "RegisterInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Nama Pengguna"
        },
        "email": {
          "type": "string",
          "example": "customer@example.com"
        },
        "password": {
          "type": "string",
          "example": "password123"
        }
      },
      "required": [
        "name",
        "email",
        "password"
      ]
    },
    "LoginInput": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "customer@example.com"
        },
        "password": {
          "type": "string",
          "example": "password123"
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "UserInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Nama Pengguna"
        },
        "email": {
          "type": "string",
          "example": "owner@example.com"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "role": {
          "type": "string",
          "example": "owner"
        }
      },
      "required": [
        "name",
        "email",
        "password",
        "role"
      ]
    },
    "MenuItemInput": {
      "type": "object",
      "properties": {
        "stallId": {
          "type": "number",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Nasi Goreng"
        },
        "price": {
          "type": "number",
          "example": 15000
        },
        "isAvailable": {
          "type": "boolean",
          "example": true
        }
      },
      "required": [
        "stallId",
        "name",
        "price"
      ]
    },
    "ReviewInput": {
      "type": "object",
      "properties": {
        "stallId": {
          "type": "number",
          "example": 1
        },
        "rating": {
          "type": "number",
          "example": 5
        },
        "comment": {
          "type": "string",
          "example": "Enak!"
        }
      },
      "required": [
        "stallId",
        "rating"
      ]
    },
    "LikeInput": {
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "number",
          "example": 1
        }
      },
      "required": [
        "reviewId"
      ]
    },
    "FlagInput": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "resolved"
        }
      },
      "required": [
        "status"
      ]
    },
    "AuditInput": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "example": "review.flagged"
        },
        "targetTable": {
          "type": "string",
          "example": "REVIEWS"
        },
        "targetId": {
          "type": "number",
          "example": 1
        },
        "metadata": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "example": "Spam"
            }
          }
        }
      },
      "required": [
        "action",
        "targetTable",
        "targetId"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "fail"
        },
        "message": {
          "type": "string",
          "example": "Validasi gagal"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "example": "name"
              },
              "message": {
                "type": "string",
                "example": "name minimal 3 karakter"
              }
            }
          }
        }
      },
      "required": [
        "status",
        "message"
      ]
    }
  },
